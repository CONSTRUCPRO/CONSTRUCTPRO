# Aplicación
APP_NAME="CONSTRUCPRO"
APP_ENV="development"
APP_DEBUG="True"
APP_PORT=8000

# Base de datos
DATABASE_URL="sqlite:///./dev.db"

# Seguridad / autenticación (HU-02), con los nombres de la guía de setup.
# Cambiar SECRET_KEY fuera de desarrollo. (También se aceptan JWT_SECRETO y JWT_MINUTOS_ACCESO.)
SECRET_KEY="cambia-este-valor-en-produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DIAS_TOKEN_RENOVACION=7
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# Aprobaciones (HU-20): tope del Coordinador en COP (RN-076)
TOPE_APROBACION_COORDINADOR=10000000
